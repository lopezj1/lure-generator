{
  "name": "luregen-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "gen:api": "openapi-typescript openapi.json -o src/lib/api.d.ts"
  },
  "dependencies": {
    "@picocss/pico": "2.1.1",
    "@sjsf/ajv8-validator": "3.10.0",
    "@sjsf/basic-theme": "3.10.0",
    "@sjsf/form": "3.10.0",
    "@standard-schema/spec": "1.1.0",
    "@types/json-schema-merge-allof": "0.6.5",
    "ajv": "8.20.0",
    "esm-env": "1.2.2",
    "json-schema-merge-allof": "0.8.1",
    "json-schema-typed": "8.0.2",
    "openapi-fetch": "0.17.0",
    "three": "0.184.0",
    "three-cad-viewer": "5.1.3",
    "three-mesh-bvh": "0.9.18"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "@types/three": "0.184.0",
    "eslint": "10.15.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.2.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8"
  },
  "overrides": {
    "three": "$three"
  }
