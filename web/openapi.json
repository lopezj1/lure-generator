          "machine": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Machine"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "build"
        ],
        "title": "FabArgs",
        "description": "`lure fab BUILD --format print|cnc [--machine M]`."
      },
      "FabCncJob": {
        "properties": {
          "op": {
            "type": "string",
            "const": "fab_cnc",
            "title": "Op"
          },
          "args": {
            "$ref": "#/components/schemas/FabArgs"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "op",
          "args"
        ],
        "title": "FabCncJob"
      },
      "FabPrintJob": {
        "properties": {
          "op": {
            "type": "string",
            "const": "fab_print",
            "title": "Op"
          },
          "args": {
            "$ref": "#/components/schemas/FabArgs"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "op",
          "args"
        ],
        "title": "FabPrintJob"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "git_sha": {
            "type": "string",
            "title": "Git Sha"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "git_sha"
        ],
        "title": "Health"
      },
      "JobCreated": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "JobCreated"
      },
      "JobInfo": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "op": {
            "type": "string",
            "title": "Op"
          },
          "request": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ProfileJob"
              },
              {
                "$ref": "#/components/schemas/BuildJob"
              },
              {
                "$ref": "#/components/schemas/FabPrintJob"
              },
              {
                "$ref": "#/components/schemas/FabCncJob"
              }
            ],
            "title": "Request",
            "discriminator": {
              "propertyName": "op",
              "mapping": {
                "build": "#/components/schemas/BuildJob",
                "fab_cnc": "#/components/schemas/FabCncJob",
                "fab_print": "#/components/schemas/FabPrintJob",
                "profile": "#/components/schemas/ProfileJob"
              }
            }
          },
          "command": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Command",
            "description": "The CLI command line (cwd = data root)."
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "returncode": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Returncode"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "progress": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobProgress"
              },
              {
                "type": "null"
              }
            ]
          },
          "last_event_id": {
            "type": "integer",
            "title": "Last Event Id",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "id",
          "op",
          "request",
          "command",
          "status",
          "created_at"
        ],
        "title": "JobInfo"
      },
      "JobProgress": {
        "properties": {
          "stage": {
            "type": "string",
            "title": "Stage"
          },
          "frac": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Frac"
          },
          "msg": {
            "type": "string",
            "title": "Msg",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "stage"
        ],
        "title": "JobProgress"
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "cancelled",
          "interrupted"
        ],
        "title": "JobStatus"
      },
      "LogData": {
        "properties": {
          "stream": {
            "type": "string",
            "enum": [
              "stdout",
              "stderr"
            ],
            "title": "Stream"
          },
          "line": {
            "type": "string",
            "title": "Line"
          }
        },
        "type": "object",
        "required": [
          "stream",
          "line"
        ],
        "title": "LogData"
      },
      "LogEvent": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "event": {
            "type": "string",
            "const": "log",
            "title": "Event",
            "default": "log"
          },
          "data": {
            "$ref": "#/components/schemas/LogData"
          }
        },
        "type": "object",
        "required": [
          "id",
          "data"
        ],
        "title": "LogEvent"
      },
      "ProfileArgs": {
        "properties": {
          "image": {
            "type": "string",
            "title": "Image"
          },
          "out": {
            "type": "string",
            "title": "Out",
            "description": "Station table CSV to write (inside the data root)."
          },
          "scale": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "aruco",
                  "length",
                  "auto"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Scale"
          },
          "length": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Length"
          },
          "marker_mm": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Marker Mm"
          },
          "top": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Top"
          },
          "width_ratio": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Width Ratio"
          },
          "n_stations": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 500.0,
                "minimum": 2.0
              },
              {
                "type": "null"
              }
            ],
            "title": "N Stations"
          },
          "nose": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "left",
                  "right"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Nose"
          },
          "smoothing": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "efd",
                  "spline"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Smoothing"
          },
          "harmonics": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 60.0,
                "minimum": 4.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Harmonics"
          },
          "rembg": {
            "type": "boolean",
            "title": "Rembg",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "image",
          "out"
        ],
        "title": "ProfileArgs",
        "description": "`lure profile IMAGE --out OUT \u2026`; paths are relative to the data root."
      },
      "ProfileJob": {
        "properties": {
          "op": {
            "type": "string",
            "const": "profile",
            "title": "Op"
          },
          "args": {
            "$ref": "#/components/schemas/ProfileArgs"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "op",
          "args"
        ],
        "title": "ProfileJob"
      },
      "ProgressEvent": {
