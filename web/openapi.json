            "type": "integer",
            "title": "Id"
          },
          "event": {
            "type": "string",
            "const": "progress",
            "title": "Event",
            "default": "progress"
          },
          "data": {
            "$ref": "#/components/schemas/JobProgress"
          }
        },
        "type": "object",
        "required": [
          "id",
          "data"
        ],
        "title": "ProgressEvent"
      },
      "ResultEvent": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "event": {
            "type": "string",
            "const": "result",
            "title": "Event",
            "default": "result"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "id",
          "data"
        ],
        "title": "ResultEvent"
      },
      "StatusData": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "returncode": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Returncode"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "StatusData"
      },
      "StatusEvent": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "event": {
            "type": "string",
            "const": "status",
            "title": "Event",
            "default": "status"
          },
          "data": {
            "$ref": "#/components/schemas/StatusData"
          }
        },
        "type": "object",
        "required": [
          "id",
          "data"
        ],
        "title": "StatusEvent"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
