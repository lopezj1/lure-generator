{
  "openapi": "3.1.0",
  "info": {
    "title": "luregen",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Submit Job",
        "description": "Queue a job; it runs `python -m luregen --progress json <cmd> \u2026` in the data root.",
        "operationId": "submit_job_api_jobs_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/ProfileJob"
                  },
                  {
                    "$ref": "#/components/schemas/BuildJob"
                  },
                  {
                    "$ref": "#/components/schemas/FabPrintJob"
                  },
                  {
                    "$ref": "#/components/schemas/FabCncJob"
                  }
                ],
                "discriminator": {
                  "propertyName": "op",
                  "mapping": {
                    "profile": "#/components/schemas/ProfileJob",
                    "build": "#/components/schemas/BuildJob",
                    "fab_print": "#/components/schemas/FabPrintJob",
                    "fab_cnc": "#/components/schemas/FabCncJob"
                  }
                },
                "title": "Req"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobCreated"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "List Jobs",
        "description": "Recent jobs first.",
        "operationId": "list_jobs_api_jobs_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JobInfo"
                  },
                  "title": "Response List Jobs Api Jobs Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Get Job Info",
        "operationId": "get_job_info_api_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{8}-\\d{6}-[0-9a-f]{6}$",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobInfo"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "jobs"
        ],
        "summary": "Cancel Job",
        "description": "Cancel: drop a queued job, or SIGTERM the running job's process group (SIGKILL\nafter a timeout). Returns the final state; 409 if the job had already finished.",
        "operationId": "cancel_job_api_jobs__job_id__delete",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{8}-\\d{6}-[0-9a-f]{6}$",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobInfo"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}/history": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Job History",
        "description": "All events so far (id > `after`) as JSON: the non-streaming twin of /events.",
        "operationId": "job_history_api_jobs__job_id__history_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{8}-\\d{6}-[0-9a-f]{6}$",
              "title": "Job Id"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "After"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/LogEvent"
                      },
                      {
                        "$ref": "#/components/schemas/ProgressEvent"
                      },
                      {
                        "$ref": "#/components/schemas/StatusEvent"
                      },
                      {
                        "$ref": "#/components/schemas/ResultEvent"
                      }
                    ],
                    "discriminator": {
                      "propertyName": "event",
                      "mapping": {
                        "log": "#/components/schemas/LogEvent",
                        "progress": "#/components/schemas/ProgressEvent",
                        "status": "#/components/schemas/StatusEvent",
                        "result": "#/components/schemas/ResultEvent"
                      }
                    }
                  },
                  "title": "Response Job History Api Jobs  Job Id  History Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}/events": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Job Events",
        "description": "SSE stream of `log` / `progress` / `result` / `status` events (data: JSON, id:\nper-job counter). Replays from the start (or after `Last-Event-ID` / `?after=`),\nthen follows live, and ends after the final `status` event.",
        "operationId": "job_events_api_jobs__job_id__events_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{8}-\\d{6}-[0-9a-f]{6}$",
              "title": "Job Id"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Resume after this event id.",
              "title": "After"
            },
            "description": "Resume after this event id."
          },
          {
            "name": "last-event-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string"
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "204": {
            "description": "Finished job, nothing after Last-Event-ID."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BuildArgs": {
        "properties": {
          "variant": {
            "type": "string",
            "title": "Variant",
            "description": "Variant TOML, relative to the data root."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "variant"
        ],
        "title": "BuildArgs",
        "description": "`lure build VARIANT [--set k=v \u2026]`."
      },
      "BuildJob": {
        "properties": {
          "op": {
            "type": "string",
            "const": "build",
            "title": "Op"
          },
          "args": {
            "$ref": "#/components/schemas/BuildArgs"
          },
          "overrides": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Overrides",
            "description": "`--set` overrides, `a.b=value`."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "op",
          "args"
        ],
        "title": "BuildJob"
      },
      "FabArgs": {
        "properties": {
          "build": {
            "type": "string",
